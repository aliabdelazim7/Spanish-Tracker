{
  "name": "spanish-tracker-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Production-grade Spanish Language Learning Platform for Arabic Speakers",
  "scripts": {
    "dev:web": "npm run dev --prefix apps/web",
    "dev:api": "php services/api/artisan serve --port=8000",
    "build:web": "npm run build --prefix apps/web",
    "test:web": "npm run test --prefix apps/web",
    "test:api": "cd services/api && php artisan test",
    "migrate:api": "cd services/api && php artisan migrate",
    "seed:api": "cd services/api && php artisan db:seed"
  }
}
